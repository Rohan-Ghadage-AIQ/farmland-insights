            "title": "Duration In Minutes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password",
          "duration_in_minutes"
        ],
        "title": "RegisterUserRequest"
      },
      "SatelliteDatesRequest": {
        "properties": {
          "farm_geojson": {
            "$ref": "#/components/schemas/FarmFeatureCollection"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "title": "Start Date"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "title": "End Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "farm_geojson",
          "start_date",
          "end_date"
        ],
        "title": "SatelliteDatesRequest",
        "description": "Which days a satellite photographed the farm within a period."
      },
      "SatelliteDatesResponse": {
        "properties": {
          "dates": {
            "items": {
              "$ref": "#/components/schemas/SatellitePass"
            },
            "type": "array",
            "title": "Dates",
            "description": "Newest first."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SatelliteDatesResponse"
      },
      "SatellitePass": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "optical": {
            "type": "boolean",
            "title": "Optical",
            "description": "A Sentinel-2 (optical) image exists for this day."
          },
          "cloud_cover": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cloud Cover",
            "description": "Percent of the farm under cloud or cloud shadow in the optical image (the whole satellite scene when the provider cannot measure the farm alone). Null when there is no optical image or it could not be measured."
          },
          "radar": {
