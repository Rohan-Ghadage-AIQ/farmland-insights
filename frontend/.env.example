# Dev-server proxy target for /api and /health (read by vite.config.ts only, never bundled)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Show the passwordless "Get token" sign-in tab. Dev/testing only (see docs/BACKEND_REQUESTS.md).
VITE_ENABLE_DEV_TOKEN_LOGIN=true
# Requested token lifetime in minutes
VITE_TOKEN_TTL_MINUTES=480
# Optional custom vector style URL
VITE_MAP_STYLE_URL=
# Optional satellite style/tiles URL
VITE_MAP_STYLE_SATELLITE_URL=
# Optional, if the map style requires a key
VITE_MAP_API_KEY=