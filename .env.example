EE_PROJECT_ID=
# The path on YOUR laptop to your GEE credentials or service-account.json
HOST_GEE_CREDENTIALS_PATH=C:/Users/MridulSinghal/.config/earthengine/credentials
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json
# Set to 1 to run live Google Earth Engine integration tests
RUN_GEE_INTEGRATION_TESTS=1
PROPELAUTH_AUTH_URL=
PROPELAUTH_API_KEY=
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
DATABASE_URI=
DATABASE_READ_URI=
DATABASE_WRITE_URI=

# Satellite data source: "gee" (Google Earth Engine, needs credentials) or "stac" (free Microsoft
# Planetary Computer, no credentials).
SATELLITE_PROVIDER=gee
# Only for "stac": prefer IPv4 for the satellite catalogue requests. Fixes ~20 s stalls on networks
# that advertise IPv6 but cannot use it. Set to false if your network needs IPv6.
STAC_PREFER_IPV4=true
